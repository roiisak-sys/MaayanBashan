# ---------------------------------------------------------------------------
# Certificate issuance — environment configuration
#
# Copy to .env for local development (.env is gitignored).
# In production set these in: Netlify → Site configuration → Environment variables
# NEVER commit real values.
# ---------------------------------------------------------------------------

# --- Airtable credentials (server-side only, never exposed to the browser) ---
# Personal Access Token with data.records:read on the CRM base.
AIRTABLE_PAT=your_airtable_personal_access_token

# Maayan Bashan CRM
AIRTABLE_BASE_ID=appiziy69WzC5SqDK
# Table: "לידים פרטי"
AIRTABLE_TABLE_NAME=tbl3s3NLLL75Siqg3

# --- Field mapping ---
# Field IDs are used rather than display names, because the column names in
# this base are Hebrew and renaming a column in the Airtable UI would silently
# break lookups. Find IDs via the Airtable API docs for the base.
AIRTABLE_NAME_FIELD=fldtIhXNTeKPPs41O
AIRTABLE_ID_FIELD=fldFPugfcZDT70yhP
AIRTABLE_STATUS_FIELD=fld9Smx5O2HTn4zus
AIRTABLE_COURSE_FIELD=fldy6DhZezw4gVZuq

# --- Eligibility ---
# Linked record ID of the target cohort ("קורס שפת גוף  יולי 2026").
TARGET_COURSE_RECORD_ID=recKv98sOFZmx3cOT
# Value of the status single-select that means "paid".
PAID_STATUS=שילם

# Require the Israeli ID to match as well as the name.
# Leave as "true" (the default). See README → "ID verification" before changing:
# setting this to "false" downgrades verification to name-only, which is
# materially less secure.
CERT_REQUIRE_ID=true

# --- Rate limiting ---
CERT_RATE_LIMIT=20
CERT_RATE_WINDOW_MS=600000

# --- Certificate assets (bundled from templates/, see netlify.toml) ---
CERTIFICATE_TEMPLATE_NAME=certificate-template.pdf
CERTIFICATE_FONT_NAME=assistant-regular.ttf
CERTIFICATE_FONT_BOLD_NAME=assistant-semibold.ttf

# --- PDF text placement (optional overrides) ---
# Defaults are measured from the supplied A4 template and should not need
# changing. Coordinates are in PDF points, origin at the BOTTOM-left.
# CERT_NAME_CENTER_X=297.96
# CERT_NAME_BASELINE_Y=497.67
# CERT_NAME_FONT_SIZE=27
# CERT_NAME_MAX_WIDTH=259
# CERT_NAME_MIN_FONT_SIZE=14
# CERT_NAME_COLOR=#f5f0e6
# CERT_ID_CENTER_X=261.2
# CERT_ID_BASELINE_Y=454.17
# CERT_ID_FONT_SIZE=9.9
# CERT_ID_MAX_WIDTH=67
# CERT_ID_MIN_FONT_SIZE=7
# CERT_ID_COLOR=#f5f0e6
