---
import BaseLayout from '../layouts/BaseLayout.astro';

// Routes worth offering someone who landed on a dead URL, rather than a bare
// "page not found" that sends them back to search.
const routes = [
  { href: '/', label: 'דף הבית', note: 'מי היא מעיין בשן ומה היא מלמדת' },
  { href: '/body-language-course/', label: 'קורס שפת גוף', note: '"ניתוח גוף פתוח" — 25 שעות הכשרה מעשית' },
  { href: '/guides/', label: 'מדריכי שפת גוף', note: 'מדריכים מעשיים, בלי קלישאות' },
  { href: '/courses/', label: 'הרצאות וקורסים', note: 'כל ההרצאות, הסדנאות והקורסים' },
  { href: '/media/', label: 'מהמדיה', note: 'טלוויזיה, עיתונות והפודקאסט' },
  { href: '/contact/', label: 'צור קשר', note: 'להזמנת הרצאה או קורס' },
];
---

<BaseLayout
  title="הדף לא נמצא"
  description="הדף שחיפשתם לא קיים באתר של מעיין בשן. כאן אפשר למצוא את הקורסים, ההרצאות והמדריכים בשפת גוף."
  bgVariant="mid"
>
  <!-- A 404 must never be indexed as a real page. -->
  <meta name="robots" content="noindex, follow" slot="head" />

  <section class="nf">
    <span class="eyebrow">404</span>
    <h1>הדף הזה לא קיים</h1>
    <p class="nf-lead">
      כנראה הקישור השתנה או שנפלה טעות בכתובת. הנה המקומות השימושיים באתר:
    </p>

    <ul class="nf-links">
      {routes.map((route) => (
        <li>
          <a href={route.href}>
            <strong>{route.label}</strong>
            <span>{route.note}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .nf { max-width: 760px; margin: 0 auto; padding: 4.5rem 1.5rem 5rem; text-align: center; }
  .nf .eyebrow {
    display: block; color: var(--gold-soft); font-weight: 800;
    letter-spacing: 0.12em; font-size: 0.95rem; margin-bottom: 0.9rem;
  }
  .nf h1 { font-size: clamp(1.9rem, 4.5vw, 2.7rem); margin: 0 0 1rem; color: var(--ink); }
  .nf-lead { color: var(--ink-dim); line-height: 1.8; margin: 0 auto 2.6rem; max-width: 46ch; }

  .nf-links {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 0.9rem;
    text-align: start;
  }
  .nf-links a {
    display: block; padding: 1.1rem 1.3rem;
    border: 1px solid var(--border); border-radius: 12px;
    background: var(--card); text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }
  .nf-links a:hover { border-color: var(--gold); transform: translateY(-2px); }
  .nf-links strong { display: block; color: var(--ink); margin-bottom: 0.3rem; }
  .nf-links span { color: var(--ink-dim); font-size: 0.92rem; line-height: 1.6; }

  @media (max-width: 600px) { .nf { padding: 3rem 1rem 4rem; } }
</style>
