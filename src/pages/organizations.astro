---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientMarquee from '../components/ClientMarquee.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import { getEntry, getCollection, render } from 'astro:content';

const org = await getEntry('organizations', 'organizations');
const settings = await getEntry('settings', 'settings');
const whatsappMessage = 'היי מעיין, אני מעוניין/ת בהרצאה או סדנה לארגון שלנו ואשמח לפרטים';
const whatsappHref = settings?.data.whatsapp
  ? `${settings.data.whatsapp}?text=${encodeURIComponent(whatsappMessage)}`
  : undefined;

// The long-form SEO block lives in the entry body so Maayan can edit it in the
// CMS alongside the catalogue, rather than in this template.
const { Content } = org ? await render(org) : { Content: null };

const lectures = org?.data.lectures ?? [];
const process = org?.data.process ?? [];
const faq = org?.data.faq ?? [];
const testimonials = org?.data.testimonials ?? [];
const photos = org?.data.photos ?? [];

// Clients come from two places: the logo collection, which carries an image,
// and the entry's own list, which is name only. Logos lead the strip, and a
// name already represented by a logo is dropped so nothing appears twice.
const clientLogos = (await getCollection('partner_logos'))
  .filter((l) => l.data.kind === 'client')
  .map((l) => ({ name: l.data.name, logo: l.data.logo, darkArtwork: l.data.darkArtwork }));
const logoNames = new Set(clientLogos.map((c) => c.name));
const clients = [
  ...clientLogos,
  ...(org?.data.clients ?? []).filter((c) => !logoNames.has(c.name) && !c.logo),
];

const PAGE_URL = 'https://maayanbashan.co.il/organizations/';
// Service + FAQ + breadcrumb, layered on the Person/WebSite graph BaseLayout
// already emits. Each lecture becomes an offer, so adding one in the CMS
// extends the structured data too.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${PAGE_URL}#service`,
      name: 'הרצאות וסדנאות שפת גוף לארגונים',
      serviceType: 'הרצאת שפת גוף לעובדים',
      description: org?.data.intro,
      provider: { '@id': 'https://maayanbashan.co.il/#person' },
      areaServed: { '@type': 'Country', name: 'Israel' },
      audience: { '@type': 'BusinessAudience', name: 'ארגונים, חברות וצוותי הנהלה' },
      url: PAGE_URL,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'קטלוג ההרצאות',
        itemListElement: lectures.map((l) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: l.title,
            description: l.summary,
            provider: { '@id': 'https://maayanbashan.co.il/#person' },
          },
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${PAGE_URL}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'בית', item: 'https://maayanbashan.co.il/' },
        { '@type': 'ListItem', position: 2, name: 'ארגונים', item: PAGE_URL },
      ],
    },
    ...(faq.length
      ? [{
          '@type': 'FAQPage',
          '@id': `${PAGE_URL}#faq`,
          mainEntity: faq.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        }]
      : []),
  ],
};
---
<BaseLayout
  title="הרצאות שפת גוף לארגונים ולעובדים"
  description="הרצאת שפת גוף לעובדים עם מעיין בשן: 90 דקות מצחיקות ומרתקות שמשאירות בידי אנשי מכירות ומשא ומתן כלי עבודה אמיתי. לקבלת הצעה."
  keywords="הרצאות לעובדים, הרצאה שפת גוף, הרצאה שפת גוף לעובדים, הרצאת העשרה לעובדים, סדנת שפת גוף, שפת גוף לארגונים, שפת גוף למנהלים, שפת גוף במכירות, שפת גוף במשא ומתן, הרצאה לאנשי מכירות, הרצאה לכנס, מעיין בשן הרצאות"
  bgVariant="deep"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <section class="organizations-page reveal">
    <nav class="breadcrumb" aria-label="מיקום בתוך האתר">
      <a href="/">בית</a> <span aria-hidden="true">›</span> <span>ארגונים</span>
    </nav>
    {org?.data.tag && <span class="eyebrow">{org.data.tag}</span>}
    <h1>{org?.data.title}</h1>
    {org?.data.intro && <p class="intro">{org.data.intro}</p>}
    <div class="hero-cta">
      <a class="btn btn-orange" href="#contact">לקבלת הצעה להרצאה ←</a>
      {whatsappHref && (
        <a class="btn-ghost" href={whatsappHref} target="_blank" rel="noopener">או בוואטסאפ</a>
      )}
    </div>
    {org?.data.benefits && (
      <div class="benefits-grid">
        {org.data.benefits.map((b) => (
          <div class="benefit-card">
            <span class="check" aria-hidden="true">✓</span>
            <div>
              <h3>{b.title}</h3>
              <p>{b.description}</p>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <ClientMarquee clients={clients} />
  <PhotoCarousel photos={photos} />

  {lectures.length > 0 && (
    <section class="lectures reveal">
      <div class="section-inner">
        <span class="eyebrow">קטלוג ההרצאות</span>
        <h2>ההרצאות שאפשר להזמין</h2>
        <p class="section-desc">
          כל ההרצאות מועברות בשיתוף הקהל, עם סרטונים, הדגמות וניתוחים מהשטח. אפשר להתאים כל אחת מהן
          לעולם התוכן שלכם בשיחת אפיון קצרה.
        </p>
        <div class="lecture-grid">
          {lectures.map((l) => (
            <article class={`lecture-card${l.featured ? ' is-featured' : ''}`}>
              {l.featured && <span class="lecture-flag">מומלץ לצוותי מכירות</span>}
              <h3>{l.title}</h3>
              <p class="lecture-meta">
                {[l.duration, l.guest ? `בשיתוף ${l.guest}` : null].filter(Boolean).join(' · ')}
              </p>
              <p class="lecture-summary">{l.summary}</p>
              {l.takeaways.length > 0 && (
                <ul class="lecture-takeaways">
                  {l.takeaways.map((t) => <li>{t}</li>)}
                </ul>
              )}
              {l.forWhom && <p class="lecture-for"><strong>מתאים ל:</strong> {l.forWhom}</p>}
            </article>
          ))}
        </div>
        <p class="section-foot">
          מחפשים משהו מעמיק יותר מהרצאה? מעיין מעבירה גם <a href="/body-language-course/">קורס שפת גוף</a>
          וסדנאות עומק לארגונים.
        </p>
        <a class="btn btn-orange" href="#contact">לבדוק איזו הרצאה מתאימה לנו ←</a>
      </div>
    </section>
  )}

  {process.length > 0 && (
    <section class="process reveal">
      <div class="section-inner">
        <span class="eyebrow">איך זה עובד</span>
        <h2>מהשיחה הראשונה ועד האירוע</h2>
        <ol class="process-list">
          {process.map((s, i) => (
            <li>
              <span class="step-num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {Content && (
    <section class="longform reveal">
      <div class="section-inner prose">
        <Content />
        <p class="longform-cta">
          <a class="btn btn-orange" href="#contact">לקבלת הצעה להרצאה ←</a>
        </p>
      </div>
    </section>
  )}

  {testimonials.length > 0 && (
    <section class="testimonials reveal">
      <div class="section-inner">
        <span class="eyebrow">מה אמרו אחרי</span>
        <h2>משובים מארגונים</h2>
        <div class="testimonial-grid">
          {testimonials.map((t) => (
            <figure class="testimonial-card">
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <strong>{t.author}</strong>
                <span>{[t.role, t.org].filter(Boolean).join(', ')}</span>
                {t.date && <span class="testimonial-date">{t.date}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {faq.length > 0 && (
    <section class="faq reveal">
      <div class="section-inner">
        <span class="eyebrow">שאלות נפוצות</span>
        <h2>מה ארגונים שואלים לפני שמזמינים</h2>
        <div class="faq-list">
          {faq.map((f) => (
            <details class="faq-item">
              <summary>{f.q}<span class="faq-plus" aria-hidden="true">+</span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {org?.data.closing && (
    <section class="closing-section reveal">
      <div class="section-inner">
        <p class="closing">{org.data.closing}</p>
        <p class="related">
          רוצים להכיר לעומק? <a href="/about/">על מעיין בשן</a> ·
          <a href="/guides/">מדריכי שפת גוף</a> ·
          <a href="/media/">מעיין בתקשורת</a>
        </p>
      </div>
    </section>
  )}
  <section class="business-contact reveal" id="contact">
    <div class="form-wrap">
      <span class="eyebrow">בואו נתאים לכם תוכנית</span>
      <h2>מעוניינים לארגון שלכם?</h2>
      <p class="form-lede">נחזור אליכם עם הצעה מדויקת לפי הקהל, הפורמט והתאריך.</p>
      {whatsappHref && (
        <a class="btn btn-teal whatsapp-cta" href={whatsappHref} target="_blank" rel="noopener">
          לשיחה מהירה בוואטסאפ ←
        </a>
      )}
      <form name="business-contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="business-contact" />
        <p class="hidden-field"><label>אל תמלאו שדה זה: <input name="bot-field" /></label></p>
        <div class="form-row">
          <label>שם מלא<input type="text" name="name" required /></label>
          <label>שם הארגון<input type="text" name="company" required /></label>
        </div>
        <div class="form-row">
          <label>טלפון<input type="tel" name="phone" required /></label>
          <label>מייל<input type="email" name="email" required /></label>
        </div>
        <label>פרטים נוספים<textarea name="message" rows="4"></textarea></label>
        <button type="submit" class="btn btn-orange">שליחה ←</button>
      </form>
      <p class="form-success" hidden>תודה! ההודעה נשלחה בהצלחה, נחזור אליכם בהקדם.</p>
      <p class="form-error" hidden>משהו השתבש. נסו שוב או צרו קשר ישירות בטלפון/במייל.</p>
    </div>
  </section>
</BaseLayout>
<style>
  .organizations-page { max-width: 820px; margin: 0 auto; padding: 3rem 2rem 3rem; }
  .organizations-page h1 { color: var(--gold); font-size: clamp(2rem, 4vw, 2.5rem); margin-bottom: 1.25rem; }
  .intro { line-height: 1.8; margin-bottom: 1.75rem; font-size: 1.1rem; max-width: 640px; color: var(--ink-dim); }
  .closing { line-height: 1.85; font-size: 1.02rem; color: var(--ink-dim); opacity: 0.85; }

  .breadcrumb { font-size: 0.85rem; color: var(--ink-dim); opacity: 0.7; margin-bottom: 1.5rem; }
  .breadcrumb a { color: inherit; }
  .breadcrumb span { margin: 0 0.3rem; }

  .hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-bottom: 2.5rem; }
  .btn-ghost { color: var(--gold); font-weight: 700; font-size: 0.95rem; }

  /* Shared shell for the sections added below the hero. */
  .section-inner { max-width: 820px; margin: 0 auto; padding: 0 2rem; }
  .lectures, .process, .longform, .faq, .closing-section { padding: 3.5rem 0; }
  .lectures h2, .process h2, .faq h2 { color: var(--gold); font-size: clamp(1.6rem, 3vw, 2.1rem); margin-bottom: 1rem; }
  .section-desc { line-height: 1.8; color: var(--ink-dim); max-width: 640px; margin-bottom: 2rem; }
  .section-foot { line-height: 1.8; color: var(--ink-dim); margin: 2rem 0 1.5rem; }

  .lecture-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .lecture-card {
    position: relative;
    background: var(--card);
    border-radius: 4px 16px 16px 16px;
    padding: 1.6rem 1.5rem;
    box-shadow: var(--shadow-hard);
  }
  /* The two sales-facing lectures are the commercial point of the page, so
     they are marked rather than left to blend into the catalogue. */
  .lecture-card.is-featured { border: 2px solid var(--gold); }
  .lecture-flag {
    display: inline-block;
    background: var(--gold);
    color: var(--navy-deep);
    font-size: 0.72rem;
    font-weight: 800;
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    margin-bottom: 0.7rem;
  }
  .lecture-card h3 { color: var(--gold); font-size: 1.15rem; margin-bottom: 0.35rem; }
  .lecture-meta { font-size: 0.85rem; color: var(--ink-dim); opacity: 0.8; margin-bottom: 0.75rem; }
  .lecture-meta:empty { display: none; }
  .lecture-summary { font-size: 0.95rem; line-height: 1.7; color: var(--ink-dim); margin-bottom: 0.9rem; }
  .lecture-takeaways { margin: 0 0 0.9rem; padding-inline-start: 1.1rem; }
  .lecture-takeaways li { font-size: 0.9rem; line-height: 1.65; color: var(--ink-dim); }
  .lecture-for { font-size: 0.86rem; line-height: 1.6; color: var(--ink-dim); opacity: 0.85; margin: 0; }
  .lecture-for strong { color: var(--gold); }

  .process-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .process-list li { display: flex; gap: 1rem; align-items: flex-start; }
  .step-num {
    flex-shrink: 0;
    width: 2.1rem; height: 2.1rem;
    border-radius: 50%;
    background: var(--gold); color: var(--navy-deep);
    font-weight: 800;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .process-list h3 { color: var(--gold); font-size: 1.05rem; margin-bottom: 0.25rem; }
  .process-list p { margin: 0; font-size: 0.95rem; line-height: 1.7; color: var(--ink-dim); }

  .prose :global(h2) { color: var(--gold); font-size: clamp(1.4rem, 2.6vw, 1.8rem); margin: 2.5rem 0 0.9rem; }
  .prose :global(p) { line-height: 1.85; color: var(--ink-dim); margin-bottom: 1.1rem; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(blockquote) {
    border-inline-start: 3px solid var(--gold);
    padding-inline-start: 1.1rem;
    margin: 1.75rem 0;
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.75rem 0; font-size: 0.9rem; }
  .prose :global(th), .prose :global(td) {
    border: 1px solid var(--border);
    padding: 0.6rem 0.75rem;
    text-align: start;
    line-height: 1.6;
  }
  .prose :global(th) { color: var(--gold); font-weight: 800; }
  .longform-cta { margin-top: 2rem; }

  .testimonials { padding: 3.5rem 0; }
  .testimonials h2 { color: var(--gold); font-size: clamp(1.6rem, 3vw, 2.1rem); margin-bottom: 1.75rem; }
  .testimonial-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .testimonial-card {
    margin: 0;
    background: var(--card);
    border-radius: 4px 16px 16px 16px;
    padding: 1.6rem 1.5rem;
    box-shadow: var(--shadow-hard);
  }
  .testimonial-card blockquote {
    margin: 0 0 1rem;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--ink);
  }
  .testimonial-card blockquote::before { content: '"'; color: var(--gold); }
  .testimonial-card blockquote::after { content: '"'; color: var(--gold); }
  .testimonial-card figcaption { display: flex; flex-direction: column; gap: 0.15rem; font-size: 0.88rem; color: var(--ink-dim); }
  .testimonial-card figcaption strong { color: var(--gold); font-size: 0.95rem; }
  .testimonial-date { opacity: 0.7; font-size: 0.82rem; }

  .faq-list { display: grid; gap: 0.75rem; }
  .faq-item {
    background: var(--card);
    border-radius: 12px;
    padding: 1.05rem 1.3rem;
    box-shadow: var(--shadow-hard);
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--ink);
    list-style: none;
    display: flex; justify-content: space-between; gap: 1rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-plus { color: var(--gold); font-weight: 800; flex-shrink: 0; }
  .faq-item[open] .faq-plus { transform: rotate(45deg); }
  .faq-item p { margin: 0.8rem 0 0; line-height: 1.8; font-size: 0.95rem; color: var(--ink-dim); }

  .related { margin-top: 1.5rem; font-size: 0.92rem; color: var(--ink-dim); }
  .related a { color: var(--gold); font-weight: 700; }
  .form-lede { color: var(--ink-dim); font-size: 0.95rem; margin-bottom: 1.5rem; }

  @media (max-width: 720px) {
    .lecture-grid, .testimonial-grid { grid-template-columns: 1fr; }
    .section-inner { padding: 0 1.5rem; }
    .organizations-page { padding: 2.5rem 1.5rem 2rem; }
    .prose :global(table) { display: block; overflow-x: auto; }
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .benefit-card {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    background: var(--card);
    border-radius: 4px 16px 16px 16px;
    padding: 1.25rem 1.4rem;
    box-shadow: var(--shadow-hard);
  }
  .benefit-card .check {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--gold);
    color: var(--navy-deep);
    font-size: 0.85rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.2rem;
  }
  .benefit-card h3 { color: var(--gold); font-size: 1.05rem; margin-bottom: 0.3rem; }
  .benefit-card p { margin: 0; font-size: 0.92rem; line-height: 1.6; color: var(--ink-dim); }
  @media (max-width: 620px) {
    .benefits-grid { grid-template-columns: 1fr; }
  }

  .business-contact { padding: 1rem 2rem 4.5rem; }
  .form-wrap {
    max-width: 620px;
    margin: 0 auto;
    background: var(--card);
    border: 3px solid var(--border);
    border-radius: 20px;
    padding: 2.75rem 2.25rem;
    box-shadow: 0.6rem 0.6rem 0 var(--gold);
    text-align: center;
  }
  .form-wrap .eyebrow { text-align: center; }
  .form-wrap h2 { color: var(--gold); margin-bottom: 1.25rem; }
  .whatsapp-cta { display: inline-block; margin-bottom: 1.75rem; background: #25d366; color: white; }
  form { display: flex; flex-direction: column; gap: 1.1rem; text-align: start; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  label { display: flex; flex-direction: column; gap: 0.35rem; font-weight: 700; font-size: 0.95rem; }
  input, textarea {
    padding: 0.7rem;
    border-radius: 10px;
    border: 1.5px solid rgba(243, 239, 227, 0.2);
    font-family: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.06);
    transition: border-color 0.15s ease;
  }
  input:focus, textarea:focus { outline: none; border-color: var(--gold); }
  .hidden-field { display: none; }
  button[type="submit"] { align-self: center; margin-top: 0.5rem; }
  .form-success, .form-error { text-align: center; font-weight: 700; margin-top: 1.25rem; }
  .form-success { color: var(--gold); }
  .form-error { color: var(--rose); }
  [hidden] { display: none; }
  @media (max-width: 560px) {
    .form-row { grid-template-columns: 1fr; }
    .form-wrap { padding: 2rem 1.5rem; }
  }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('form[name="business-contact"]');
  const successMessage = document.querySelector<HTMLElement>('.form-success');
  const errorMessage = document.querySelector<HTMLElement>('.form-error');

  const encode = (data: FormData) =>
    Array.from(data.entries())
      .map(([key, value]) => `${encodeURIComponent(key)}=${encodeURIComponent(String(value))}`)
      .join('&');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    errorMessage?.setAttribute('hidden', '');

    const formData = new FormData(form);

    fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: encode(formData),
    })
      .then((response) => {
        if (!response.ok) throw new Error('Form submission failed');
        form.hidden = true;
        successMessage?.removeAttribute('hidden');
      })
      .catch(() => {
        errorMessage?.removeAttribute('hidden');
      });
  });
</script>
