---
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import MetaPixel from '../components/MetaPixel.astro';
import Attribution from '../components/Attribution.astro';
import '../styles/global.css';

const PAYMENT_URL = 'https://secure.cardcom.solutions/EA/EA5/4SwsNP9VJ0ueOlqA9OOBzg/PaymentSP';

const dates = ['23.10', '30.10', '13.11', '20.11', '27.11'];

const outcomes = [
  {
    title: 'לתפוס רגש לפני שהוא נאמר',
    text: 'מיקרו-הבעות נמשכות שבריר שנייה — ורוב האנשים מפספסים אותן. תתאמנו לזהות אותן בזמן אמת, עד שתדעו מה מישהו מרגיש לפני שהוא בוחר מה לומר לכם.',
  },
  {
    title: 'לדעת מתי משהו לא נכון',
    text: 'שקר משאיר חמישה סימנים שגוף לא יכול להסתיר, גם כשהמילים מתוזמנות לדייק. תלמדו לקרוא אותם — ותפסיקו להאמין רק כי המשפט נשמע משכנע.',
  },
  {
    title: 'לשלוט בקצב הקריאה שלכם',
    text: 'המיקרו-מבט קולט פרט בודד; המאקרו-שדר קורא את התמונה כולה. עם שחקן מול הקבוצה תתרגלו לעבור בין השניים בלייב — לא בתיאוריה, בסימולציה אמיתית עם קול ולחץ זמן.',
  },
  {
    title: 'להיכנס לחדר בלי לדבר',
    text: 'נוכחות נקראת לפני שפותחים את הפה — ביציבה, בקצב הנשימה, באופן שבו עומדים. תעבדו על הגרסה שלכם, לא על חיקוי, כך שהביטחון יישאר אמיתי גם תחת לחץ.',
  },
  {
    title: 'להשפיע בלי שירגישו שהשפעתם',
    text: 'הצד השני קולט תת-הכרתית הרבה לפני שהוא מודע לזה. תלמדו להוביל שיחה ולשתול נקודת מבט באמצעות הגוף שלכם — באופן שמרגיש לצד השני כמו ההחלטה שלו.',
  },
];

const faqs = [
  {
    q: 'נדרש רקע קודם בתחום?',
    a: 'לא. הקורס בנוי הדרגתית מהיסוד, לפי שיטה מסודרת ועם תרגול מעשי בכל שלב. גם משתתפים ללא רקע קודם מסיימים אותו עם מיומנות עבודה.',
  },
  {
    q: 'האם מקבלים תעודה בסיום?',
    a: 'כן. בתום הקורס מונפקת תעודת סיום אישית על שם המשתתף/ת.',
  },
  {
    q: 'מה אם אפסיד מפגש?',
    a: 'אפשר להשלים אותו במחזור הבא או לקבל גישה להקלטת המפגש שהוחמץ.',
  },
  {
    q: 'הקורס רלוונטי גם למי שלא במכירות או בניהול?',
    a: 'כן. לצד אנשי מקצוע שקריאת אנשים היא חלק מעבודתם, הקורס מתאים לכל מי שרוצה להבין בצורה מדויקת יותר את מי שמולו — בעבודה, במשפחה ובחיים האישיים.',
  },
  {
    q: 'יש לי כבר רקע בתקשורת בין-אישית. זה חופף?',
    a: 'שפת הגוף היא רובד משלים ולא חופף: היא עוסקת במה שנאמר ללא מילים. הכלים כאן יתווספו לידע הקיים ויחדדו אותו.',
  },
  {
    q: 'מה תנאי הביטול?',
    a: 'ביטול והחזר מלא אפשרי עד שבוע לפני תחילת הקורס.',
    extra: {
      title: 'נספח – מדיניות ביטול השתתפות בקורס',
      intro: 'משתתף המבקש לבטל את השתתפותו בקורס יודיע על כך בכתב, באמצעות אחת מהדרכים הבאות:',
      contacts: ['WhatsApp: 050-558-5177', 'דוא"ל: maayan.inst@gmail.com'],
      rules: [
        'במקרה של ביטול ההשתתפות עד 7 ימים לפני מועד פתיחת הקורס, יינתן החזר כספי מלא.',
        'במקרה של ביטול ההשתתפות החל מ־7 ימים ועד 3 ימים לפני מועד פתיחת הקורס, יינתן החזר בשיעור של 50% מעלות הקורס.',
        'במקרה של ביטול ההשתתפות פחות מ־3 ימים לפני פתיחת הקורס, או לאחר תחילת הקורס, לא יינתן החזר כספי.',
      ],
      outro: 'מועד קבלת הודעת הביטול בכתב אצל מפעילת הקורס הוא שייחשב כמועד הביטול לצורך חישוב הזכאות להחזר. הוראות נספח זה יחולו בכפוף להוראות כל דין, ובכל מקרה שבו קיימת לצרכן זכות שאינה ניתנת להתניה לפי חוק, יחולו הוראות הדין המחייבות.',
    },
  },
];
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>קורס שפת גוף - "ניתוח גוף פתוח" | מעיין בשן</title>
    <meta name="description" content='הכשרה מקצועית בשפת גוף ובתקשורת בלתי-מילולית עם מעיין בשן (מעין בשן) — קורס "ניתוח גוף פתוח", 25 שעות, 5 מפגשי עומק, אוקטובר-נובמבר 2026, הרצליה' />
    <meta name="keywords" content="קורס שפת גוף, לימודי שפת גוף, קורס שפת גוף מעיין בשן, קורס שפת גוף הרצליה, קורס שפת גוף תל אביב, לימודי תעודה שפת גוף, קורס זיהוי שקרים, קורס מיקרו הבעות, ניתוח גוף פתוח, מעיין בשן, מעין בשן, שפת גוף, תקשורת לא מילולית, קריאת שפת גוף" />
    <meta name="google-site-verification" content="eP1EVt4zfY7kOhKGsSnLYR49MPqn7bKNlRavQqKDkGo" />
    <link rel="canonical" href="https://maayanbashan.co.il/body-language-course/" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content='קורס שפת גוף - "ניתוח גוף פתוח" | מעיין בשן' />
    <meta property="og:description" content='הכשרה מקצועית בשפת גוף עם מעיין בשן — קורס "ניתוח גוף פתוח", 25 שעות, 5 מפגשי עומק, הרצליה' />
    <meta property="og:url" content="https://maayanbashan.co.il/body-language-course/" />
    <meta property="og:image" content="https://maayanbashan.co.il/images/maayan-hero.png" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content="מעיין בשן" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Structured data: Course -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Course',
      name: 'קורס ניתוח גוף פתוח',
      description: 'הכשרה מקצועית בשפת גוף ובתקשורת בלתי-מילולית עם מעיין בשן - 25 שעות, 5 מפגשי עומק, תרגול מונחה ופידבק אישי. זיהוי חוסר אמת ומניפולציה, נוכחות והשפעה.',
      provider: {
        '@type': 'Person',
        name: 'מעיין בשן',
        sameAs: 'https://maayanbashan.co.il',
      },
      offers: {
        '@type': 'Offer',
        price: '1600',
        priceCurrency: 'ILS',
        availability: 'https://schema.org/InStock',
        url: 'https://maayanbashan.co.il/body-language-course/',
      },
      hasCourseInstance: {
        '@type': 'CourseInstance',
        courseMode: 'Onsite',
        location: {
          '@type': 'Place',
          name: 'הרצליה',
        },
        startDate: '2026-10-23',
      },
    })} />
    <MetaPixel />
  </head>
  <body>
    <Attribution />
    <nav class="lp-nav">
      <a href="/" class="lp-logo"><img src="/images/logo-white.png" alt="מעיין בשן" /></a>
      <a href="#register" class="lp-nav-cta">הרשמה לקורס</a>
    </nav>

    <!-- HERO — dark, atmospheric -->
    <section class="lp-hero">
      <div class="lp-hero-shapes" aria-hidden="true">
        <span class="shape shape-ring"></span>
        <span class="shape shape-blob"></span>
        <span class="shape shape-dot-grid"></span>
        <span class="shape shape-tri"></span>
      </div>
      <div class="lp-hero-text">
        <div class="lp-eyebrow-pill">✦ הכשרה מקצועית בשפת גוף · מחזור אוקטובר 2026</div>
        <h1>לקרוא אנשים<br />כמו <em class="lp-marker">ספר פתוח</em></h1>
        <p class="lp-hero-sub">25 שעות הכשרה מעשית בשפת גוף ובתקשורת בלתי-מילולית עם מעיין בשן — חמישה מפגשי עומק, תרגול מונחה ופידבק אישי בכל מפגש.</p>
        <ul class="lp-bullets">
          <li><strong>זיהוי חוסר אמת ומניפולציה:</strong> לפי סימנים מוגדרים, לא לפי תחושת בטן</li>
          <li><strong>קריאת כוונות ורגש:</strong> בפגישות, במשא ומתן ובראיונות</li>
          <li><strong>ניהול הנוכחות שלכם:</strong> יציבה, קול ומבט — גם תחת לחץ</li>
          <li><strong>השפעה מדויקת:</strong> להוביל שיחה מבלי להפעיל כוח</li>
        </ul>
        <div class="lp-cta-row">
          <a href="#register" class="lp-btn lp-btn-hero">להרשמה לקורס ←</a>
          <div class="lp-price-tag">
            <span class="lp-price-old">3,000 ₪</span>
            <strong>1,600 ₪</strong>
            <span>מתחילים 23.10.26 · הרצליה</span>
          </div>
        </div>
      </div>
      <div class="lp-hero-image">
        <span class="lp-hero-halo" aria-hidden="true"></span>
        <img src="/images/maayan-hero.png" alt="מעיין בשן" />
      </div>
    </section>

    <!-- TRUST BAR -->
    <div class="lp-trust-bar">
      <div><span>20+</span>שנות ניסיון</div>
      <div><span>אלפי</span>בוגרים</div>
      <div><span>25</span>שעות הכשרה</div>
      <div><span>תעודה</span>בסיום הקורס</div>
      <div><span>#1</span>בשפת גוף בישראל</div>
    </div>

    <!-- INTRO VIDEO -->
    <section class="lp-section lp-video-section reveal">
      <div class="lp-inner lp-center">
        <div class="lp-eyebrow">על המנחה</div>
        <h2>הכירו את <em class="lp-marker-soft">מעיין בשן</em></h2>
        <div class="lp-video">
          <iframe
            src="https://www.youtube-nocookie.com/embed/aRz4WRds2rE"
            title="סרטון פתיחה - מעיין בשן"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <!-- STORY — editorial, serif quote -->
    <section class="lp-section lp-section-alt lp-story reveal">
      <div class="lp-inner lp-story-grid">
        <div class="lp-story-photo">
          <span class="lp-photo-ring" aria-hidden="true"></span>
          <img src="/images/maayan-about.png" alt="מעיין בשן" />
        </div>
        <div class="lp-story-text">
          <div class="lp-eyebrow">הסיפור שמאחורי השיטה</div>
          <h2>איך הפכתי<br />למומחית שפת גוף</h2>
          <p>הייתי בת 21, מוכרת רצפות עץ, כשהופיע עורך דין מרשים. חליפה נוצצת, הצעה מפתה — אבל משהו בעיניים, בידיים, בקול לא הסתדר לי. הבטן צעקה לברוח, אבל שיתפתי פעולה.</p>
          <p>שלוש שנים של שגשוג — עד שביום בהיר הוא נעלם עם 300,000 ₪. המשכתי. הקמתי עסק, נישאתי, ילדתי. ואז רואה חשבון חדש, עיניים שלא פגשו את שלי. שוב התעלמתי. שוב — התרסקות. חוב של 1.7 מיליון ₪.</p>
          <blockquote class="lp-oath">
            <span class="lp-oath-mark">"</span>
            באותו לילה נשבעתי: אני אלמד את השפה שהגוף מדבר.
            <strong>אדע הכל על אנשים בלי שיוציאו מילה.</strong>
          </blockquote>
          <p>ומאז לא הפסקתי: מאות שעות תרגול, עשרות קורסים, אלפי תלמידים. פיתחתי שיטה. היא עובדת — לא רק בשבילי, אלא גם עבורכם.</p>
        </div>
      </div>
    </section>

    <!-- OUTCOMES — dark, ghost numbers -->
    <section class="lp-section lp-section-ink lp-outcomes-section reveal">
      <div class="lp-inner">
        <div class="lp-eyebrow lp-eyebrow-orange">תוכנית הקורס</div>
        <h2 class="lp-on-ink">חמש יכולות <em class="lp-marker">שנרכשות בתרגול</em></h2>
        <p class="lp-section-desc lp-on-ink-muted">לא רשימת מושגים להקשיב לה. כל יכולת נלמדת במפגש ייעודי, מתורגלת באותו מפגש מול הקבוצה ומול מצלמה, ומקבלת פידבק אישי — כך שהיא ניתנת ליישום כבר למחרת.</p>
        <div class="lp-outcomes">
          {outcomes.map((o, i) => (
            <div class="lp-outcome">
              <span class="lp-ghost-num" aria-hidden="true">{i + 1}</span>
              <div class="lp-outcome-body">
                <h3>{o.title}</h3>
                <p>{o.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- AUDIENCE -->
    <section class="lp-section reveal">
      <div class="lp-inner">
        <div class="lp-eyebrow">למי הקורס מיועד</div>
        <h2>הכשרה למי שקריאת אנשים <em class="lp-marker-soft">היא חלק מהעבודה</em></h2>
        <p class="lp-section-desc">הקורס נבנה עבור אנשי מקצוע שנדרשים להבין במדויק את מי שיושב מולם — וגם עבור מי שרוצה להוסיף לעצמו מיומנות אמיתית, לא עוד הרצאת העשרה.</p>
        <div class="lp-audience">
          <div class="lp-audience-card"><h3>מנהלים ומובילי צוותים</h3><p>לקרוא את החדר, לזהות התנגדות שקטה ולדעת מתי "כן" הוא באמת כן.</p></div>
          <div class="lp-audience-card"><h3>מכירות ומשא ומתן</h3><p>לזהות את נקודת ההיסוס של הצד השני ולדעת מתי לדחוף ומתי לעצור.</p></div>
          <div class="lp-audience-card"><h3>מטפלים, יועצים ומאמנים</h3><p>לקלוט את מה שהמטופל לא אומר במילים, ולעבוד עם זה בזמן אמת.</p></div>
          <div class="lp-audience-card"><h3>גיוס, ראיונות וחקירות</h3><p>להבחין בין לחץ טבעי לבין הסתרה, ולשאול את השאלה הנכונה בתזמון הנכון.</p></div>
          <div class="lp-audience-card"><h3>עורכי דין ואנשי מקצוע מול קהל</h3><p>לנהל נוכחות ואמינות בחדר, גם כשהלחץ גבוה.</p></div>
          <div class="lp-audience-card"><h3>וגם: בלי רקע קודם</h3><p>הקורס בנוי הדרגתית מהיסוד, ואינו מניח ידע מוקדם בתחום.</p></div>
        </div>
      </div>
    </section>

    <!-- SCHEDULE -->
    <section class="lp-section lp-section-alt reveal">
      <div class="lp-inner">
        <div class="lp-eyebrow">מתכונת הקורס</div>
        <h2>5 מפגשים × 5 שעות = <em class="lp-marker-soft">25 שעות הכשרה</em></h2>
        <p class="lp-section-desc">ימי שישי בבוקר · 9:00–14:00 · הרצליה · אוקטובר–נובמבר 2026</p>
        <div class="lp-tickets">
          {dates.map((d, i) => (
            <div class="lp-ticket">
              <span class="lp-ticket-day">שישי</span>
              <span class="lp-ticket-date">{d}</span>
              <span class="lp-ticket-num">מפגש {i + 1}</span>
            </div>
          ))}
        </div>
        <div class="lp-meta-grid">
          <div class="lp-meta-item">
            <span class="lp-emoji">🕘</span>
            <div><h4>שעות</h4><p>9:00 עד 14:00 בכל מפגש</p></div>
          </div>
          <div class="lp-meta-item">
            <span class="lp-emoji">📍</span>
            <div><h4>מיקום</h4><p>הרצליה — חניה חינם, מרחב נעים ומרווח</p></div>
          </div>
          <div class="lp-meta-item lp-meta-urgent">
            <span class="lp-urgency-dot" aria-hidden="true"></span>
            <div><h4>מספר המקומות מוגבל</h4><p>הקבוצה נשמרת קטנה כדי לאפשר תרגול ופידבק אישי</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- PRICE — hard frames, offset shadows -->
    <section class="lp-section reveal">
      <div class="lp-inner">
        <div class="lp-eyebrow">עלות</div>
        <h2>עלות ההכשרה</h2>
        <p class="lp-section-desc">קורסי שפת גוף במתכונת דומה נעים בין 4,000 ל-9,000 ₪, ושעת ליווי אישי עולה מעל 1,000 ₪.</p>
        <div class="lp-price-grid">
          <div class="lp-price-card">
            <div class="lp-price-label">מחיר לנרשמים מהאתר</div>
            <div class="lp-price-was">מחיר מלא: 3,000 ₪</div>
            <div class="lp-price-now">1,600 <span>₪</span></div>
