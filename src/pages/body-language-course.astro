    <script is:inline>
      const form = document.querySelector('form[name="course-registration"]');
      const submitButton = form?.querySelector('button[type="submit"]');
      const successMessage = document.querySelector('.lp-form-success');
      const errorMessage = document.querySelector('.lp-form-error');
      let isSubmitting = false;
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (isSubmitting) return; // guard against double-click / double-tap
        isSubmitting = true;
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.dataset.originalText = submitButton.textContent ?? '';
          submitButton.textContent = 'שולח...';
        }
        errorMessage?.setAttribute('hidden', '');
        const formData = new FormData(form);
        const encode = Array.from(formData.entries())
          .map(([key, value]) => encodeURIComponent(key) + '=' + encodeURIComponent(String(value)))
          .join('&');

        // Lead goes to two places: Netlify Forms (email notification + backup)
        // and the CRM via the course-lead function. Success if either landed.
        const netlifyForms = fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: encode,
        }).then((r) => r.ok);

        // Attribution from the layout: this visit's ad tags, or the last
        // tagged visit, or the referrer marked as organic. Never empty.
        const utm = window.mbAttribution ? window.mbAttribution() : {};

        const crm = fetch('/api/course-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: formData.get('name'),
            email: formData.get('email'),
            phone: formData.get('phone'),
            ...utm,
          }),
        }).then(async (r) => (r.ok ? (await r.json().catch(() => ({}))) : false)).catch(() => false);

        Promise.allSettled([netlifyForms, crm]).then((results) => {
          const anyOk = results.some((r) => r.status === 'fulfilled' && r.value);
          const crmResult = results[1].status === 'fulfilled' ? results[1].value : null;
          if (anyOk) {
            if (window.fbq) window.fbq('track', 'Lead', { content_name: 'course-registration' });
            form.hidden = true;
            successMessage?.removeAttribute('hidden');
            // Registration continues straight into the secure payment page.
            // The link on the success block stays as a manual fallback.
            if (crmResult && crmResult.payUrl) {
              window.location.href = crmResult.payUrl;
            }
          } else {
            errorMessage?.removeAttribute('hidden');
            isSubmitting = false;
            if (submitButton) {
              submitButton.disabled = false;
              submitButton.textContent = submitButton.dataset.originalText ?? submitButton.textContent;
            }
          }
        });
      });

      // Reveal-on-scroll
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in-view'));
      }
    </script>
  </body>
</html>

<style>
