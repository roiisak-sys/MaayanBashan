---
import { getEntry } from 'astro:content';
import MemberOffer from '../components/MemberOffer.astro';

const entry = await getEntry('members', 'organizations');
---
<MemberOffer
  entry={entry!}
  title="קורס שפת גוף בהנחה לחברי הארגון"
  description="השתתפתם בהרצאה של מעיין בשן בארגון? קורס שפת הגוף המלא, ניתוח גוף פתוח, 25 שעות, במחיר מיוחד לחברי הארגון."
  keywords="קורס שפת גוף לעובדים, קורס שפת גוף מחיר מיוחד, ניתוח גוף פתוח, מעיין בשן קורס, הטבה לעובדים"
  attendedWhat="בהרצאה שלך בארגון"
/>
