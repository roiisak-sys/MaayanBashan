---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { sortSessions, shortDate, shortDateWithYear, isoDate, cycleLabel } from '../lib/cycle';

const page = await getEntry('members', 'members');
const course = await getEntry('courses', 'open-body-analysis-course');
const settings = await getEntry('settings', 'settings');

// Dates come from the same cycle the public course page uses, so this page can
// never drift from it: one cohort, one source.
const sessions = sortSessions(course?.data.sessions ?? []);
const firstSession = sessions[0];
const label = cycleLabel(sessions);
const dates = sessions.map(shortDate);

const d = page?.data;
// A price claim is only made when both numbers are set. A discount the payment
// page would not honour is worse than no number at all.
const showPrice = typeof d?.memberPrice === 'number' && typeof d?.regularPrice === 'number';
const saving = showPrice ? d!.regularPrice! - d!.memberPrice! : 0;

const whatsappMessage = `היי מעיין, השתתפתי בהרצאה שלך בארגון ואשמח לפרטים על הקורס${d?.couponCode ? ` (קוד ${d.couponCode})` : ''}`;
const whatsappHref = settings?.data.whatsapp
  ? `${settings.data.whatsapp}?text=${encodeURIComponent(whatsappMessage)}`
  : undefined;
---
<BaseLayout
  title="קורס שפת גוף מלא במחיר לחברי הארגון"
  description="השתתפתם בהרצאה של מעיין בשן בארגון? קורס שפת הגוף המלא, ניתוח גוף פתוח, 25 שעות, במחיר מיוחד לחברי הארגון."
  keywords="קורס שפת גוף לעובדים, קורס שפת גוף מחיר מיוחד, ניתוח גוף פתוח, מעיין בשן קורס, הטבה לעובדים"
  bgVariant="deep"
>
  <!-- This page is a private offer for people who attended a lecture, so it is
       kept out of search results and out of the sitemap. -->
  <meta slot="head" name="robots" content="noindex, follow" />

  <section class="mem-hero reveal">
    <div class="mem-inner mem-hero-grid">
      <div class="mem-hero-text">
      <span class="eyebrow">הטבה לחברי הארגון</span>
      <h1>
        {d?.courseName && <span class="mem-h1-lead">{d.courseName}</span>}
        {d?.title}
      </h1>
      <p class="mem-intro">{d?.intro}</p>

      {d?.couponCode && (
        <div class="mem-coupon">
          <span class="mem-coupon-label">קוד ההטבה</span>
          <strong class="mem-coupon-code">{d.couponCode}</strong>
          {d.couponNote && <span class="mem-coupon-note">{d.couponNote}</span>}
        </div>
      )}

      {showPrice && (
        <p class="mem-price">
          <span class="mem-price-was">{d!.regularPrice!.toLocaleString('he-IL')} ₪</span>
          <strong>{d!.memberPrice!.toLocaleString('he-IL')} ₪</strong>
          <span class="mem-price-save">חיסכון של {saving.toLocaleString('he-IL')} ₪</span>
        </p>
      )}

      <div class="mem-cta-row">
        <a class="btn btn-orange" href="#register">להרשמה עם הקוד ←</a>
        {whatsappHref && (
          <a class="mem-ghost" href={whatsappHref} target="_blank" rel="noopener">שאלה בוואטסאפ</a>
        )}
      </div>
      </div>

      {d?.heroImage && (
        <div class="mem-hero-image">
          <span class="mem-hero-halo" aria-hidden="true"></span>
          <img
            src={d.heroImage}
            alt={d.heroImageAlt ?? 'מעיין בשן'}
            width="340"
            height="340"
            fetchpriority="high"
          />
        </div>
      )}
    </div>
  </section>

  {d?.stats?.length ? (
    <div class="mem-trust">
      {d.stats.map((s) => (
        <div><span>{s.value}</span>{s.label}</div>
      ))}
    </div>
  ) : null}

  {d?.bullets?.length ? (
    <section class="mem-what reveal">
      <div class="mem-inner">
        <h2>מה יש בקורס</h2>
        <ul class="mem-bullets">
          {d.bullets.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </section>
  ) : null}

  {d?.audience?.length ? (
    <section class="mem-audience-section reveal">
      <div class="mem-inner">
        <h2>למי זה מיועד</h2>
        <p class="mem-sub">הקורס נבנה עבור אנשי מקצוע שנדרשים להבין במדויק את מי שיושב מולם, וגם עבור מי שרוצה להוסיף לעצמו מיומנות אמיתית.</p>
        <div class="mem-audience">
          {d.audience.map((a) => (
            <div class="mem-audience-card">
              <h3>{a.title}</h3>
              <p>{a.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : null}

  {d?.videoId ? (
    <section class="mem-video-section reveal">
      <div class="mem-inner">
        <h2>מה אומרים הבוגרים</h2>
        <div class="mem-video">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${d.videoId}`}
            title={d.videoTitle ?? 'סרטון'}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>
  ) : null}

  <section class="mem-when reveal">
    <div class="mem-inner">
      <h2>מתי ואיפה</h2>
      <div class="mem-facts">
        <div><span>מתכונת</span><strong>5 מפגשים · 25 שעות</strong></div>
        <div><span>ימים</span><strong>שישי, 9:00–14:00</strong></div>
        <div><span>מיקום</span><strong>הרצליה</strong></div>
        {label && <div><span>מחזור</span><strong>{label}</strong></div>}
      </div>
      {dates.length > 0 && (
        <p class="mem-dates">
          {dates.map((x, i) => (
            <><span class="mem-date">{x}</span>{i < dates.length - 1 && <span class="mem-sep" aria-hidden="true">·</span>}</>
          ))}
        </p>
      )}
    </div>
  </section>

  {d?.faq?.length ? (
    <section class="mem-faq reveal">
      <div class="mem-inner">
        <h2>שאלות</h2>
        {d.faq.map((f) => (
          <details class="mem-faq-item">
            <summary>{f.q}<span aria-hidden="true">+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  ) : null}

  <section class="mem-register reveal" id="register">
    <div class="mem-form-wrap">
      <h2>הרשמה</h2>
      {d?.closing && <p class="mem-closing">{d.closing}</p>}
      <form id="mem-form" novalidate>
        <div class="mem-row">
          <label>שם מלא<input type="text" name="name" required autocomplete="name" /></label>
          <label>טלפון<input type="tel" name="phone" required autocomplete="tel" inputmode="tel" /></label>
        </div>
        <label>מייל<input type="email" name="email" autocomplete="email" /></label>
        <label>הארגון שבו שמעת את ההרצאה<input type="text" name="organization" autocomplete="organization" /></label>
        {d?.couponCode && (
          <label>קוד הטבה<input type="text" name="coupon" value={d.couponCode} readonly /></label>
        )}
        <button type="submit" class="btn btn-orange">להמשך להרשמה ←</button>
      </form>
      <p class="mem-sending" hidden>רק רגע, שומרים את הפרטים...</p>
      <p class="mem-error" hidden>אירעה תקלה בשליחה. נסו שוב, או דברו איתנו בוואטסאפ.</p>
      <p class="mem-note">אחרי השליחה תועברו לעמוד תשלום מאובטח.</p>
    </div>
  </section>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'קורס ניתוח גוף פתוח',
    description: d?.intro,
    provider: { '@id': 'https://maayanbashan.co.il/#person' },
    inLanguage: 'he-IL',
    ...(firstSession
      ? { hasCourseInstance: {
            '@type': 'CourseInstance',
            courseMode: 'Onsite',
            location: { '@type': 'Place', name: 'הרצליה' },
            startDate: isoDate(firstSession),
          } }
      : {}),
  })} />
</BaseLayout>
<style>
  .mem-inner { max-width: 680px; margin: 0 auto; padding: 0 1.75rem; }
  .mem-hero { padding: 3.5rem 0 2.5rem; }

  /* The hero is the only wide block on the page: the portrait sits beside the
     offer, and everything below stays in the narrow reading column. */
  .mem-hero-grid { max-width: 980px; display: flex; align-items: center; gap: 2.5rem; }
  .mem-hero-text { flex: 1 1 auto; min-width: 0; }
  .mem-hero h1 { color: var(--gold); font-size: clamp(1.9rem, 4.5vw, 2.6rem); margin-bottom: 1rem; line-height: 1.25; }
  /* The course name leads the headline, so a reader arriving from a lecture
     knows which course this is before reading anything else. */
  .mem-h1-lead {
    display: block;
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
    margin-bottom: 0.5rem;
  }

  /* Explicit width: without it the flex item is sized from the portrait's
     intrinsic width and swallows the hero copy's space. */
  .mem-hero-image { position: relative; flex: 0 0 300px; width: 300px; }
  /* Square box, so the 50% radius is a circle rather than an ellipse and the
     portrait matches the ring drawn around it. */
  .mem-hero-image img {
    width: 100%;
    /* The height attribute on the tag is a presentation hint that would pin the
       box and leave aspect-ratio inert; auto hands the height back to it. */
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center top;
    display: block;
    border-radius: 50%;
  }
  .mem-hero-halo {
    position: absolute; inset: -14px;
    border: 1.5px solid rgba(201, 160, 92, 0.45);
    border-radius: 50%;
  }
  .mem-intro { line-height: 1.85; color: var(--ink-dim); font-size: 1.05rem; margin-bottom: 1.75rem; }

  .mem-coupon {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6rem;
    background: var(--card);
    border: 2px dashed var(--gold);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
  }
  .mem-coupon-label { font-size: 0.85rem; color: var(--ink-dim); }
  .mem-coupon-code {
    color: var(--gold); font-size: 1.35rem; font-weight: 800;
    letter-spacing: 0.08em; font-family: var(--font-serif, inherit);
  }
  .mem-coupon-note { font-size: 0.85rem; color: var(--ink-dim); opacity: 0.8; width: 100%; }

  .mem-price { display: flex; align-items: baseline; gap: 0.7rem; flex-wrap: wrap; margin-bottom: 1.75rem; }
  .mem-price-was { text-decoration: line-through; opacity: 0.5; }
  .mem-price strong { color: var(--gold); font-size: 1.8rem; font-weight: 800; }
  .mem-price-save { font-size: 0.9rem; color: var(--rose); font-weight: 700; }

  .mem-cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .mem-ghost { color: var(--gold); font-weight: 700; font-size: 0.95rem; }

  /* Full-bleed credibility strip, the same four figures the course page runs. */
  .mem-trust {
    display: flex; justify-content: center; flex-wrap: wrap;
    gap: 1.25rem 3rem;
    padding: 1.4rem 1.75rem;
    background: rgba(0, 0, 0, 0.25);
    border-block: 1px solid var(--border);
    font-weight: 600;
  }
  .mem-trust div { display: flex; align-items: baseline; gap: 0.45rem; }
  .mem-trust span { font-size: 1.7rem; font-weight: 800; color: var(--gold); }

  .mem-audience-section, .mem-video-section { padding: 2.5rem 0; }
  .mem-sub { line-height: 1.75; color: var(--ink-dim); margin-bottom: 1.4rem; }
  .mem-audience { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .mem-audience-card {
    background: var(--card);
    border-radius: 4px 14px 14px 14px;
    padding: 1.1rem 1.2rem;
    box-shadow: var(--shadow-hard);
  }
  .mem-audience-card h3 { color: var(--gold); font-size: 1rem; margin-bottom: 0.3rem; }
  .mem-audience-card p { margin: 0; font-size: 0.9rem; line-height: 1.6; color: var(--ink-dim); }

  /* Reserved 16:9 box, so the player cannot shift the page as it loads. */
  .mem-video { position: relative; aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; box-shadow: var(--shadow-hard); }
  .mem-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .mem-what, .mem-when, .mem-faq { padding: 2.5rem 0; }
  .mem-what h2, .mem-when h2, .mem-faq h2, .mem-register h2 {
    color: var(--gold); font-size: clamp(1.4rem, 3vw, 1.75rem); margin-bottom: 1.1rem;
  }
  .mem-bullets { margin: 0; padding-inline-start: 1.2rem; }
  .mem-bullets li { line-height: 1.75; color: var(--ink-dim); margin-bottom: 0.6rem; }

  .mem-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem; }
  .mem-facts div { display: flex; flex-direction: column; gap: 0.2rem; }
  .mem-facts span { font-size: 0.82rem; color: var(--ink-dim); opacity: 0.75; }
  .mem-facts strong { color: var(--ink); font-size: 0.98rem; }
  .mem-dates { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin: 0; }
  .mem-date {
    background: var(--card); border-radius: 8px;
    padding: 0.3rem 0.65rem; font-weight: 700; font-size: 0.92rem; color: var(--gold);
  }
  .mem-sep { opacity: 0.3; }

  .mem-faq-item {
    background: var(--card); border-radius: 10px;
    padding: 0.9rem 1.1rem; margin-bottom: 0.6rem;
  }
  .mem-faq-item summary {
    cursor: pointer; font-weight: 700; color: var(--ink); list-style: none;
    display: flex; justify-content: space-between; gap: 1rem;
  }
  .mem-faq-item summary::-webkit-details-marker { display: none; }
  .mem-faq-item summary span { color: var(--gold); flex-shrink: 0; }
  .mem-faq-item[open] summary span { transform: rotate(45deg); }
  .mem-faq-item p { margin: 0.7rem 0 0; line-height: 1.75; font-size: 0.95rem; color: var(--ink-dim); }

  .mem-register { padding: 1rem 1.75rem 4rem; }
  .mem-form-wrap {
    max-width: 560px; margin: 0 auto;
    background: var(--card);
    border: 3px solid var(--border);
    border-radius: 18px;
    padding: 2.25rem 1.9rem;
    box-shadow: 0.5rem 0.5rem 0 var(--gold);
  }
  .mem-closing { color: var(--ink-dim); font-size: 0.95rem; line-height: 1.7; margin-bottom: 1.4rem; }
  #mem-form { display: flex; flex-direction: column; gap: 1rem; }
  .mem-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  #mem-form label { display: flex; flex-direction: column; gap: 0.35rem; font-weight: 700; font-size: 0.92rem; }
  #mem-form input {
    padding: 0.7rem; border-radius: 10px;
    border: 1.5px solid rgba(243, 239, 227, 0.2);
    font-family: inherit; font-size: 1rem;
    color: var(--ink); background: rgba(255, 255, 255, 0.06);
  }
  #mem-form input:focus { outline: none; border-color: var(--gold); }
  #mem-form input[readonly] { opacity: 0.8; letter-spacing: 0.06em; font-weight: 700; color: var(--gold); }
  #mem-form input[aria-invalid='true'] { border-color: var(--rose); }
  #mem-form button { align-self: center; margin-top: 0.4rem; }
  .mem-sending, .mem-error { text-align: center; font-weight: 700; margin-top: 1rem; }
  .mem-error { color: var(--rose); }
  .mem-note { text-align: center; font-size: 0.82rem; color: var(--ink-dim); opacity: 0.7; margin-top: 1rem; }
  [hidden] { display: none !important; }

  /* Below this the portrait stops earning its column and moves above the copy,
     at a size that does not push the offer off the first screen. */
  @media (max-width: 860px) {
    .mem-hero-grid { flex-direction: column-reverse; align-items: stretch; gap: 1.75rem; }
    .mem-hero-image { flex: 0 0 auto; width: 190px; margin: 0 auto; }
  }
  @media (max-width: 620px) {
    .mem-audience { grid-template-columns: 1fr; }
    .mem-trust { gap: 0.9rem 2rem; }
    .mem-trust span { font-size: 1.45rem; }
  }
  @media (max-width: 560px) {
    .mem-row, .mem-facts { grid-template-columns: 1fr; }
    .mem-form-wrap { padding: 1.75rem 1.35rem; }
  }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('#mem-form');
  const sending = document.querySelector<HTMLElement>('.mem-sending');
  const error = document.querySelector<HTMLElement>('.mem-error');

  // Ad attribution travels with the lead, the same four fields the rest of the
  // site sends, so a registration can be traced back to wherever the link ran.
  const params = new URLSearchParams(location.search);
  const utm = (k: string) => params.get(k) ?? '';

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    error?.setAttribute('hidden', '');

    const data = new FormData(form);
    const required = ['name', 'phone'];
    let bad = false;
    for (const key of required) {
      const field = form.elements.namedItem(key) as HTMLInputElement | null;
      const ok = Boolean(String(data.get(key) ?? '').trim());
      field?.setAttribute('aria-invalid', ok ? 'false' : 'true');
      if (!ok && !bad) { field?.focus(); bad = true; }
    }
    if (bad) return;

    const button = form.querySelector('button');
    if (button) button.disabled = true;
    sending?.removeAttribute('hidden');

    try {
      const response = await fetch('/api/members-course-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: data.get('name'),
          phone: data.get('phone'),
          email: data.get('email'),
          organization: data.get('organization'),
          coupon: data.get('coupon'),
          utm_source: utm('utm_source'),
          utm_medium: utm('utm_medium'),
          utm_campaign: utm('utm_campaign'),
          utm_content: utm('utm_content'),
          ad_id: utm('ad_id'),
          fbclid: utm('fbclid'),
        }),
      });
      const result = await response.json();
      if (!response.ok || !result.payUrl) throw new Error('no pay url');
      window.location.href = result.payUrl;
    } catch {
      sending?.setAttribute('hidden', '');
      error?.removeAttribute('hidden');
      if (button) button.disabled = false;
    }
  });
</script>
