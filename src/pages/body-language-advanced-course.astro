---
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import MetaPixel from '../components/MetaPixel.astro';
import '../styles/global.css';

const PAYMENT_URL = 'https://secure.cardcom.solutions/EA/EA5/VEmNO09CUOPMpERwwew/PaymentSP';

const dates = ['6.1', '13.1', '20.1', '27.1', '3.2', '10.2'];

const modules = [
  {
    title: 'זוגיות, דייטים וחדר המיטות',
    text: 'קריאת אותות משיכה, קרבה ואמת במרחב הכי אינטימי שיש - מפגישה ראשונה ועד חדר השינה. מה הגוף מגלה כשהמילים משתיקות.',
  },
  {
    title: 'אלימות והפרעות אישיות',
    text: 'שפת גוף שמנבאת אלימות ומאפיינים גופניים של הפרעות אישיות (כולל פסיכופתיה). תלמדו לזהות נורות אדומות ואותות אזהרה עוד לפני שהם הופכים למילים.',
  },
  {
    title: 'סטוריטלינג ועמידה מול קהל',
    text: 'איך מספרים סיפור ומלבישים אותו בשפת גוף שמחזיקה קהל - שני מפגשים ייחודיים בשיתוף השחקן <strong>אמנון וולף</strong>.',
  },
  {
    title: 'זיהוי שקרים ברמה מקצועית',
    text: 'לא עוד סימן אחד או שניים. צלילה מעמיקה לזיהוי מיקרו-ביטויים, חוסר אמת ומניפולציות - הרבה מעבר למה שנלמד בקורס הבסיסי.',
  },
  {
    title: 'משא ומתן וקבלת החלטות',
    text: 'לקרוא את הצד השני בזמן אמת, לדעת מתי לדחוף ומתי לעצור, ולנהל את שפת הגוף שלכם כך שתשרת אתכם סביב השולחן.',
  },
];

const faqs = [
  {
    q: 'האם הקורס מתאים למי שלא סיים את הקורס הבסיסי?',
    a: 'לא. הקורס המתקדם מיועד אך ורק לבוגרי הקורס הבסיסי "ניתוח גוף פתוח" של מעיין בשן - הוא בנוי כהמשך ישיר, לא כמבוא.',
  },
  {
    q: 'מה ההבדל מהקורס הבסיסי?',
    a: 'הקורס הבסיסי מלמד את השפה עצמה מאפס. הקורס המתקדם תוקף את שפת הגוף לפי זוויות - אלימות, זוגיות, שקרים, משא ומתן - עם הרבה יותר תרגול מעשי: מיקרו-הבעות ועמידה מול קהל ומצלמה.',
  },
  {
    q: 'כמה משתתפים בקבוצה?',
    a: 'עד 40 בוגרים בלבד, כדי לשמור על רמת תרגול אישי גבוהה בכל מפגש.',
  },
  {
    q: 'מה אם אפסיד מפגש?',
    a: 'אפשר להשלים בקורס הבא או לקבל גישה להקלטת המפגש שהחסרתם.',
  },
  {
    q: 'מה קורה בכל מפגש בפועל?',
    a: 'שעתיים הרצאה על הנושא של אותו מפגש, ואחריהן שעתיים תרגול מעשי צמוד עם מעיין ופידבק מיידי - מיקרו-הבעות, סימולציות, ועמידה מול קהל ומצלמה. סה"כ 4 שעות למפגש.',
  },
  {
    q: 'מה תנאי הביטול?',
    a: 'ביטול והחזר מלא אפשרי עד 14 יום לפני תחילת הקורס. ביטול מאוחר יותר כרוך בדמי ביטול לפי המדיניות המלאה (פירוט למטה).',
    extra: {
      title: 'נספח – מדיניות ביטול השתתפות בקורס',
      intro: 'משתתף המבקש לבטל את השתתפותו בקורס יודיע על כך בכתב, באמצעות אחת מהדרכים הבאות:',
      contacts: ['WhatsApp: 050-558-5177', 'דוא"ל: maayan.inst@gmail.com'],
      rules: [
        'במקרה של ביטול ההשתתפות עד 14 ימים לפני מועד פתיחת הקורס, יינתן החזר כספי מלא (ללא עלות).',
        'במקרה של ביטול ההשתתפות החל מ־14 ימים ועד 7 ימים לפני מועד פתיחת הקורס, יינתן החזר בשיעור של 50% מעלות הקורס.',
        'במקרה של ביטול ההשתתפות פחות מ־7 ימים לפני פתיחת הקורס, או לאחר תחילת הקורס, לא יינתן החזר כספי (חיוב מלא בעלות הקורס).',
      ],
      outro: 'מועד קבלת הודעת הביטול בכתב אצל מפעילת הקורס הוא שייחשב כמועד הביטול לצורך חישוב הזכאות להחזר. הוראות נספח זה יחולו בכפוף להוראות כל דין, ובכל מקרה שבו קיימת לצרכן זכות שאינה ניתנת להתניה לפי חוק, יחולו הוראות הדין המחייבות.',
    },
  },
];
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>שפת גוף - קורס מתקדמים | מעיין בשן</title>
    <meta name="description" content='קורס המשך בלעדי לבוגרי "ניתוח גוף פתוח" - 6 מפגשי העשרה ותרגול מעשי אינטנסיבי עם מעיין בשן. אלימות, זוגיות, שקרים ומשא ומתן.' />
    <meta name="keywords" content="מעיין בשן, מעין בשן, שפת גוף, שפתגוף, קורס מתקדמים, ניתוח גוף פתוח" />
    <meta name="google-site-verification" content="eP1EVt4zfY7kOhKGsSnLYR49MPqn7bKNlRavQqKDkGo" />
    <link rel="canonical" href="https://maayanbashan.co.il/body-language-advanced-course/" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="שפת גוף - קורס מתקדמים | מעיין בשן" />
    <meta property="og:description" content='קורס המשך בלעדי לבוגרי "ניתוח גוף פתוח" - 6 מפגשים, ינואר-פברואר 2027, הרצליה' />
    <meta property="og:url" content="https://maayanbashan.co.il/body-language-advanced-course/" />
    <meta property="og:image" content="https://maayanbashan.co.il/images/maayan-hero.png" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content="מעיין בשן" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Structured data: Course -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Course',
      name: 'שפת גוף - קורס מתקדמים',
      description: 'קורס המשך לבוגרי "ניתוח גוף פתוח" - 6 מפגשי העשרה ותרגול מעשי: אלימות והפרעות אישיות, זוגיות ודייטים, סטוריטלינג, שקרים, משא ומתן.',
      provider: {
        '@type': 'Person',
        name: 'מעיין בשן',
        sameAs: 'https://maayanbashan.co.il',
      },
      offers: {
        '@type': 'Offer',
        price: '3800',
        priceCurrency: 'ILS',
        availability: 'https://schema.org/InStock',
        url: 'https://maayanbashan.co.il/body-language-advanced-course/',
      },
      hasCourseInstance: {
        '@type': 'CourseInstance',
        courseMode: 'Onsite',
        location: {
          '@type': 'Place',
          name: 'אשכול פיס, הרצליה',
        },
        startDate: '2027-01-06',
      },
    })} />
    <MetaPixel />
  </head>
  <body>
    <nav class="ac-nav">
      <a href="/" class="ac-logo"><img src="/images/logo-white.png" alt="מעיין בשן" /></a>
      <a href="#register" class="ac-nav-cta">הרשמה לקורס</a>
    </nav>

    <!-- TOP STRIP -->
    <div class="ac-top-strip">
      <div class="ac-badge">🎓 רק לבוגרים שלנו</div>
      <div class="ac-eyebrow-pill">✦ קורס מתקדמים בשפת גוף · ינואר 2027</div>
    </div>

    <!-- PRACTICE EMPHASIS -->
    <section class="ac-section ac-practice-section reveal">
      <svg class="ac-motif ac-motif-body" viewBox="0 0 120 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M60 15a15 15 0 1 1 0 30 15 15 0 0 1 0-30Z" stroke="currentColor" stroke-width="1" opacity="0.5"/>
        <path d="M60 45v60M35 70c8-6 17-9 25-9s17 3 25 9M40 105h40M45 105l-8 60M75 105l8 60" stroke="currentColor" stroke-width="1" opacity="0.5"/>
        <circle cx="60" cy="45" r="2.5" fill="currentColor" opacity="0.7"/>
        <circle cx="35" cy="70" r="2.5" fill="currentColor" opacity="0.7"/>
        <circle cx="85" cy="70" r="2.5" fill="currentColor" opacity="0.7"/>
      </svg>
      <svg class="ac-motif ac-motif-speech" viewBox="0 0 140 90" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M15 15h90a10 10 0 0 1 10 10v35a10 10 0 0 1-10 10H55l-20 18v-18H15A10 10 0 0 1 5 60V25A10 10 0 0 1 15 15Z" stroke="currentColor" stroke-width="1" opacity="0.5"/>
        <circle cx="40" cy="42" r="2.5" fill="currentColor" opacity="0.7"/>
        <circle cx="65" cy="42" r="2.5" fill="currentColor" opacity="0.7"/>
        <circle cx="90" cy="42" r="2.5" fill="currentColor" opacity="0.7"/>
      </svg>
      <div class="ac-inner">
        <div class="ac-practice-top">
          <div class="ac-practice-text">
            <h2>גם ידע מתקדם.<br /><em class="ac-marker">גם יכולת ליישם</em>.</h2>
            <p class="ac-practice-lead">
              הכוח של קורס למתקדמים טמון בשילוב המדויק בין התרגול לתאוריה - בכל מפגש צוללים לידע תיאורטי ברמה הגבוהה ביותר, ומייד עולים לתרגל אותו בשטח, ממש באותו ערב. זה לא מבנה של "קודם לומדים, ואולי יום אחד נתרגל" - זה מבנה שחוזר על עצמו בכל אחד משישה המפגשים: תיאוריה עמוקה, ואז תרגול מיידי על אותו החומר, מול המצלמה, מול הקבוצה, ועם פידבק אישי ומדויק של מעיין על כל תזוזה ומיקרו-הבעה. כך יוצאים מכל מפגש בנפרד - לא רק בסוף הקורס - גם עם תובנות עמוקות וחדשות, וגם עם מיומנות פרקטית שמשתמשים בה כבר למחרת בבוקר.
            </p>
            <p class="ac-practice-note">התהליך הזה - לומדים, מתרגלים, יוצאים עם יכולת - חוזר בכל אחד משישה המפגשים, לא רק פעם אחת בקורס.</p>
          </div>
          <div class="ac-practice-photo">
            <span class="ac-practice-photo-frame" aria-hidden="true"></span>
            <img src="/images/maayan-hero.png" alt="מעיין בשן" />
          </div>
        </div>
        <div class="ac-practice-grid">
          <div class="ac-practice-card">
            <span class="ac-practice-num">01</span>
            <h3>לומדים</h3>
            <p>שעתיים הרצאת עומק על שפת גוף מזווית אחרת בחיים - ידע חדש שלא נלמד בקורס הבסיסי</p>
          </div>
          <div class="ac-practice-arrow" aria-hidden="true">←</div>
          <div class="ac-practice-card">
            <span class="ac-practice-num">02</span>
            <h3>מתרגלים</h3>
            <p>שעתיים תרגול מעשי אינטנסיבי - מיקרו-הבעות, סימולציות, ניתוח בזמן אמת ועמידה מול קהל ומצלמה</p>
          </div>
          <div class="ac-practice-arrow" aria-hidden="true">←</div>
          <div class="ac-practice-card ac-practice-card-gold">
            <span class="ac-practice-num">03</span>
            <h3>יוצאים עם יכולת</h3>
            <p>פידבק מדויק ומיידי על כל תרגיל, בכל אחד מששת המפגשים - כדי שהידע לא יישאר על הנייר, אלא יהפוך ליכולת טבעית בשטח</p>
          </div>
        </div>
      </div>
    </section>

    <!-- HERO -->
    <section class="ac-hero">
      <div class="ac-hero-shapes" aria-hidden="true">
        <span class="ac-shape ac-shape-diamond1"></span>
        <span class="ac-shape ac-shape-diamond2"></span>
        <svg class="ac-hero-motif" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M100 20c-30 0-45 22-45 45 0 12 5 20 5 32 0 18-12 25-12 45 0 20 22 36 52 36s52-16 52-36c0-20-12-27-12-45 0-12 5-20 5-32 0-23-15-45-45-45Z" stroke="currentColor" stroke-width="1" opacity="0.5"/>
          <path d="M100 20v158M70 55c8 6 12 14 12 24M130 55c-8 6-12 14-12 24M62 100c10 4 16 10 18 20M138 100c-10 4-16 10-18 20" stroke="currentColor" stroke-width="1" opacity="0.5"/>
          <circle cx="70" cy="55" r="2.5" fill="currentColor" opacity="0.7"/>
          <circle cx="130" cy="55" r="2.5" fill="currentColor" opacity="0.7"/>
          <circle cx="62" cy="100" r="2.5" fill="currentColor" opacity="0.7"/>
          <circle cx="138" cy="100" r="2.5" fill="currentColor" opacity="0.7"/>
          <circle cx="100" cy="150" r="2.5" fill="currentColor" opacity="0.7"/>
        </svg>
      </div>
      <div class="ac-hero-text ac-hero-text-solo">
        <h1>לקחת את הכלים מהקורס הבסיסי —<br />ולהפוך אותם <em class="ac-marker">למיומנות אוטומטית</em>.</h1>
        <p class="ac-hero-sub">6 מפגשים פרונטליים של 4 שעות - מחצית תיאוריה ומחצית תרגול מעשי בכל מפגש - על הבמה ובזוגות.</p>
        <ul class="ac-bullets">
          <li><strong>מו״מ וזיהוי שקרים:</strong> טכניקות מתקדמות לגילוי חוסר אמת ושליטה בשיחה</li>
          <li><strong>פרופיילינג וסכנה:</strong> זיהוי הפרעות אישיות ונורות אדומות בשפת גוף</li>
          <li><strong>זוגיות ואינטימיות:</strong> פענוח שפת הגוף בחדר המיטות, בדייטים ובתקשורת זוגית</li>
          <li><strong>סטוריטלינג ונוכחות:</strong> עמידה מול קהל והעברת מסר כריזמטי, בשיתוף השחקן אמנון וולף</li>
        </ul>
        <div class="ac-cta-row">
          <a href="#register" class="ac-btn ac-btn-hero">אני רוצה לשריין מקום ←</a>
          <div class="ac-price-tag">
            <span class="ac-price-old">4,400 ₪</span>
            <strong>3,800 ₪ בלבד</strong>
            <span>מתחילים 6.1.27 · אשכול פיס, הרצליה</span>
          </div>
        </div>
      </div>
    </section>

    <!-- TRUST BAR -->
    <div class="ac-trust-bar">
      <div><span>20+</span>שנות ניסיון</div>
      <div><span>40</span>מקומות בלבד</div>
      <div><span>6</span>מפגשי העשרה</div>
      <div><span>1:1</span>יחס תרגול-הרצאה</div>
    </div>

    <!-- MODULES -->
    <section class="ac-section ac-section-alt reveal ac-section-motif">
      <svg class="ac-motif ac-motif-eye" viewBox="0 0 120 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M10 30c15-20 45-24 50-24s35 4 50 24c-15 20-45 24-50 24s-35-4-50-24Z" stroke="currentColor" stroke-width="1" opacity="0.5"/>
        <circle cx="60" cy="30" r="12" stroke="currentColor" stroke-width="1" opacity="0.5"/>
        <circle cx="60" cy="30" r="3" fill="currentColor" opacity="0.7"/>
      </svg>
      <div class="ac-inner">
        <div class="ac-eyebrow">מה לומדים</div>
        <h2><em class="ac-marker-soft">המבט ההקפי</em>: קריאת שפת גוף מזוויות מורכבות</h2>
        <p class="ac-section-desc">מיישמים את התיאוריה בפועל: תרגול מזוויות שלא הכרתם.</p>
        <div class="ac-modules">
          {modules.map((m, i) => (
            <div class="ac-module">
              <span class="ac-module-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="ac-module-body">
                <h3>{m.title}</h3>
                <p set:html={m.text} />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- GUEST: AMNON WOLF -->
    <section class="ac-section reveal">
      <div class="ac-inner ac-guest-grid">
        <div class="ac-guest-photos">
          <img src="/images/advanced-course/maayan-amnon-piggyback.jpg" alt="מעיין בשן ואמנון וולף" class="ac-guest-photo-main" />
          <img src="/images/advanced-course/maayan-amnon-back-to-back.jpg" alt="מעיין בשן ואמנון וולף" class="ac-guest-photo-accent" />
        </div>
        <div class="ac-guest-text">
          <div class="ac-eyebrow">אורח מיוחד בשני מפגשי הסטוריטלינג</div>
          <h2>מעיין בשן <em class="ac-marker-soft">ואמנון וולף</em></h2>
          <p>שניים מהמפגשים המיוחדים בקורס נעשים בשיתוף השחקן אמנון וולף - איך מספרים סיפור, ואיך מלבישים את המילים בשפת גוף נכונה שתפתח לכם דלתות להשיג כל דבר שתבחרו.</p>
        </div>
      </div>
    </section>

    <!-- SCHEDULE -->
    <section class="ac-section ac-section-alt reveal">
      <div class="ac-inner">
        <div class="ac-eyebrow">לוח זמנים</div>
        <h2>6 <em class="ac-marker-soft">מפגשי עומק</em></h2>
        <p class="ac-section-desc">ימי רביעי · 17:00–21:00 · אשכול פיס, הרצליה · ינואר–פברואר 2027</p>
        <div class="ac-tickets">
          {dates.map((d, i) => (
            <div class="ac-ticket">
              <span class="ac-ticket-day">רביעי</span>
              <span class="ac-ticket-date">{d}</span>
              <span class="ac-ticket-num">מפגש {i + 1}</span>
            </div>
          ))}
        </div>
        <div class="ac-meta-grid">
