---
// A swipeable strip of photographs from real lectures.
//
// The track is a scroll-snap container, so touch devices get native momentum
// and snapping with no JavaScript at all. The arrows and dots are progressive
// enhancement layered on top; with scripting off the strip still scrolls.
// The strip usually runs without a heading: the photographs sit under the
// lecture catalogue and speak for themselves. Pass a title only where one earns
// its place; the arrows and the accessible label work either way.
interface Props {
  photos: { src: string; alt: string }[];
  eyebrow?: string;
  title?: string;
}
const { photos, eyebrow, title } = Astro.props;
const label = title ?? 'תמונות מהרצאות של מעיין בשן';
---
{photos.length > 0 && (
  <section class="photo-carousel reveal">
    <div class="pc-inner">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <div class={`pc-head${title ? '' : ' is-bare'}`}>
        {title && <h2>{title}</h2>}
        <div class="pc-arrows">
          <button type="button" class="pc-arrow" data-dir="prev" aria-label="התמונה הקודמת">‹</button>
          <button type="button" class="pc-arrow" data-dir="next" aria-label="התמונה הבאה">›</button>
        </div>
      </div>

      <div class="pc-track" role="group" aria-label={label} tabindex="0">
        {photos.map((p, i) => (
          <figure class="pc-slide">
            <img
              src={p.src}
              alt={p.alt}
              width="1200"
              height="800"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </figure>
        ))}
      </div>

      <div class="pc-dots" role="tablist" aria-label="מעבר בין תמונות">
        {photos.map((_, i) => (
          <button
            type="button"
            class="pc-dot"
            role="tab"
            data-index={i}
            aria-label={`תמונה ${i + 1} מתוך ${photos.length}`}
            aria-selected={i === 0 ? 'true' : 'false'}
          ></button>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .photo-carousel { padding: 3.5rem 0; }
  .pc-inner { max-width: 820px; margin: 0 auto; padding: 0 2rem; }
  .pc-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .pc-head h2 { color: var(--gold); font-size: clamp(1.6rem, 3vw, 2.1rem); margin: 0; }
  /* With no heading there is nothing to sit opposite, so the arrows take the
     start edge and the gap above the photographs tightens. */
  .pc-head.is-bare { justify-content: flex-start; margin-bottom: 0.9rem; }

  .pc-arrows { display: flex; gap: 0.5rem; flex-shrink: 0; }
  .pc-arrow {
    width: 2.4rem; height: 2.4rem;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    background: var(--card);
    color: var(--gold);
    font-size: 1.4rem; line-height: 1;
    cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    transition: border-color 0.15s ease, opacity 0.15s ease;
  }
  .pc-arrow:hover { border-color: var(--gold); }
  .pc-arrow:disabled { opacity: 0.35; cursor: default; }
  .pc-arrow:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }

  .pc-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    /* The scrollbar is noise here; the dots already report position. */
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .pc-track::-webkit-scrollbar { display: none; }
  .pc-track:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }

  .pc-slide {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: center;
  }
  .pc-slide img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 14px;
    display: block;
    box-shadow: var(--shadow-hard);
  }

  .pc-dots { display: flex; justify-content: center; gap: 0.5rem; margin-top: 1.1rem; }
  .pc-dot {
    width: 8px; height: 8px;
    padding: 0;
    border-radius: 50%;
    border: none;
    background: var(--ink-dim);
    opacity: 0.35;
    cursor: pointer;
    transition: opacity 0.15s ease, background 0.15s ease;
  }
  .pc-dot[aria-selected='true'] { background: var(--gold); opacity: 1; }
  .pc-dot:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .pc-track { scroll-behavior: auto; }
  }
  @media (max-width: 720px) {
    .pc-inner { padding: 0 1.5rem; }
    /* Touch users swipe, so the arrows only take up room. */
    .pc-arrows { display: none; }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.photo-carousel').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.pc-track');
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.pc-dot')];
    const arrows = [...root.querySelectorAll<HTMLButtonElement>('.pc-arrow')];
    const slides = [...root.querySelectorAll<HTMLElement>('.pc-slide')];
    if (!track || !slides.length) return;

    const current = () => Math.round(Math.abs(track.scrollLeft) / track.clientWidth);

    const goTo = (i: number) => {
      const clamped = Math.max(0, Math.min(slides.length - 1, i));
      // RTL scrollLeft runs negative in most engines, so the sign is taken
      // from the direction the browser actually reports rather than assumed.
      const dir = getComputedStyle(root).direction === 'rtl' ? -1 : 1;
      track.scrollTo({ left: dir * clamped * track.clientWidth });
    };

    const sync = () => {
      const i = current();
      dots.forEach((d, n) => d.setAttribute('aria-selected', String(n === i)));
      arrows.forEach((a) => {
        a.disabled = a.dataset.dir === 'prev' ? i === 0 : i === slides.length - 1;
      });
    };

    arrows.forEach((a) =>
      a.addEventListener('click', () => goTo(current() + (a.dataset.dir === 'next' ? 1 : -1)))
    );
    dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));
    track.addEventListener('keydown', (e) => {
      // In RTL the right arrow key moves to the previous slide.
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current() - 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(current() + 1); }
    });

    let tick: number;
    track.addEventListener('scroll', () => {
      clearTimeout(tick);
      tick = window.setTimeout(sync, 80);
    });
    window.addEventListener('resize', sync);
    sync();
  });
</script>
