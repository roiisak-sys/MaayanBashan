---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import MetaPixel from '../components/MetaPixel.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  bgVariant?: 'deep' | 'base' | 'mid' | 'light';
}
const {
  title,
  description = 'מעיין בשן - מומחית שפת גוף, מרצה ופרשנית תקשורת לא מילולית. הרצאות, קורסים ופודקאסט "ניתוח גוף פתוח".',
  keywords = 'מעיין בשן, מעין בשן, שפת גוף, שפתגוף, ניתוח גוף פתוח, מומחית שפת גוף, קריאת שפת גוף, זיהוי שקרים, חתונמי',
  ogImage = '/images/maayan-hero.png',
  bgVariant = 'base',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? title : `${title} | מעיין בשן - מומחית שפת גוף`;
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="מעיין בשן" />
    <meta name="google-site-verification" content="eP1EVt4zfY7kOhKGsSnLYR49MPqn7bKNlRavQqKDkGo" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700&family=Heebo:wght@700;800;900&family=Frank+Ruhl+Libre:wght@500;700;900&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content="מעיין בשן" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured data: Person + WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': 'https://maayanbashan.co.il/#person',
          name: 'מעיין בשן',
          alternateName: ['מעין בשן', 'Maayan Bashan', 'Maayan Bashan body language'],
          jobTitle: 'מומחית שפת גוף ותקשורת בלתי-מילולית',
          description: 'מעיין בשן - מומחית שפת גוף, מרצה ופרשנית תקשורת לא מילולית, מנחת הפודקאסט "ניתוח גוף פתוח". למעלה מ-20 שנות ניסיון בתחום.',
          url: 'https://maayanbashan.co.il',
          image: ogImageURL.toString(),
          nationality: { '@type': 'Country', name: 'Israel' },
          knowsLanguage: ['he', 'en'],
          email: 'maayan.inst@gmail.com',
          telephone: '+972-50-558-5177',
          sameAs: [
            'https://www.instagram.com/maayan.bashan/',
            'https://www.tiktok.com/@maayan.bashan',
            'https://www.facebook.com/sfatgoof1/',
            'https://www.youtube.com/@Maayan.bashan',
            'https://open.spotify.com/show/03Rq0mo36Cz92l8sHh5ltL',
            'https://creators.spotify.com/pod/profile/maayan-bashan/',
          ],
          knowsAbout: [
            'שפת גוף',
            'תקשורת בלתי-מילולית',
            'קריאת אנשים',
            'מיקרו-הבעות',
            'זיהוי שקרים',
            'זיהוי מניפולציות',
            'שפת גוף במשא ומתן',
            'שפת גוף במכירות',
            'נוכחות וכריזמה',
            'ניתוח גוף פתוח',
            'body language',
            'non-verbal communication',
          ],
          worksFor: {
            '@type': 'Organization',
            '@id': 'https://maayanbashan.co.il/#organization',
            name: 'מעיין בשן - שפת גוף',
            url: 'https://maayanbashan.co.il',
            areaServed: { '@type': 'Country', name: 'Israel' },
          },
        },
        {
          '@type': 'WebSite',
          '@id': 'https://maayanbashan.co.il/#website',
          url: 'https://maayanbashan.co.il',
          name: 'מעיין בשן - מומחית שפת גוף',
          description: 'הרצאות, סדנאות וקורסים בשפת גוף ותקשורת בלתי-מילולית עם מעיין בשן.',
          inLanguage: 'he-IL',
          publisher: { '@id': 'https://maayanbashan.co.il/#person' },
        },
      ],
    })} />
    <MetaPixel />
  </head>
  <body data-theme={bgVariant}>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', (user) => {
          if (!user) {
            window.netlifyIdentity.on('login', () => {
              document.location.href = '/admin/';
            });
          }
        });
      }
    </script>
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.01, rootMargin: '0px 0px -10% 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in-view'));
      }
    </script>
  </body>
</html>
